# Browser-visible Vite configuration. Use your own Supabase project.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_APP_ORIGIN=https://your-kithwork-domain.example
# Optional. Point the in-app Source links to your corresponding source repository.
VITE_SOURCE_REPOSITORY_URL=https://github.com/your-account/your-kithwork

# Server-only Vercel Function configuration. Never prefix these with VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
CRON_SECRET=replace_with_a_random_value_of_at_least_32_characters

# Supabase Edge Function secrets. Configure these in Supabase, not Vercel.
APP_ORIGIN=https://your-kithwork-domain.example
ALLOWED_ORIGINS=https://your-kithwork-domain.example
SESSION_HASH_SECRET=replace_with_a_separate_random_value_of_at_least_32_characters

# Optional outbound email delivery through your own Resend account.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Kithwork <kithwork@your-verified-domain.example>
