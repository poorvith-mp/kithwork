{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kithwork",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  }
}
